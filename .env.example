# ---- Flask backend (loaded from .env by backend/__init__.py) ----

# Signs admin tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Checked against the password typed at /admin. Generate it with:
#   flask --app backend hash-password
# Wrap the value in single quotes so `$` characters survive.
ADMIN_PASSWORD_HASH=

# Public origin of this API, with no trailing slash. Required on PythonAnywhere:
# uploaded media URLs are built from it so the Vercel frontend can load them.
PUBLIC_BASE_URL=https://YOURUSERNAME.pythonanywhere.com

# Browser origins allowed to call the API (comma separated, * supported).
# Defaults to http://localhost:5173 and https://*.vercel.app. Add a custom
# frontend domain here if you use one.
# ALLOWED_ORIGINS=https://your-site.vercel.app,https://yourdomain.com

# How long an admin login lasts, in seconds (default 12 hours).
# ADMIN_TOKEN_MAX_AGE=43200

# Optional overrides (defaults shown).
# DATABASE_PATH=instance/portfolio.db
# MEDIA_ROOT=instance/media
# MAX_UPLOAD_MB=50
