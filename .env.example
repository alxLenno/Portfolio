# ---- Flask backend (loaded from .env by backend/__init__.py) ----

# Signs the admin session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Checked against the password typed at /admin. Generate it with:
#   flask --app backend hash-password
# Wrap the value in single quotes so `$` characters survive.
ADMIN_PASSWORD_HASH=

# Optional overrides (defaults shown).
# DATABASE_PATH=instance/portfolio.db
# MEDIA_ROOT=instance/media
# MAX_UPLOAD_MB=50

# 1 = session cookie only over HTTPS (correct for PythonAnywhere).
# 0 = allow plain-HTTP local testing.
SESSION_COOKIE_SECURE=1
